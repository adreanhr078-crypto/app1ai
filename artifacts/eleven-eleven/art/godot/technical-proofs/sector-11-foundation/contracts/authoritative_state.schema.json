{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "11.11/foundation/authoritative-state/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "sessionId", "contentVersion", "revision", "flags", "receipts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "sessionId": { "type": "string", "minLength": 8, "maxLength": 160 },
    "contentVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
    "revision": { "type": "integer", "minimum": 0 },
    "flags": { "type": "object", "additionalProperties": { "type": "boolean" } },
    "checkpoint": { "type": ["object", "null"] },
    "receipts": { "type": "array", "items": { "type": "object" }, "maxItems": 128 }
  }
}
